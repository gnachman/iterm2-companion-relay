node_modules/
dist/
*.log
# Wrangler local state / scratch (Cloudflare dev); never commit
.wrangler/
# Stray captured terminal transcript (leaks hostname / prompts); never commit
/output
# SQLite state (relay pairings); never commit
*.db
*.db-shm
*.db-wal
# Filled-in deploy configs: hold the dashboard password / push token. Never
# commit. The glob covers per-host variants (deploy-relay2.env, ...) while
# still tracking deploy.env.example.
ops/deploy.env
ops/deploy-*.env
# Relay watcher: local secrets + runtime artifacts (incident reports, tick
# state, logs). The scripts, playbook, and example env stay tracked.
ops/watch/watch.env
ops/watch/state/
ops/watch/incidents/

# Stray repo-root secrets file (real config lives in ops/watch/watch.env / ops/deploy.env)
/.env
