# iTerm2 relay monitor -- config. Copy to monitor.env (gitignored) and fill in,
# or install as the systemd EnvironmentFile (see ops/iterm2-relay-monitor.service).
# Every value can also come from the real process environment; anything already
# set in the environment wins over this file.
#
# Run it on a Linux box you control, ideally a DIFFERENT hosting provider from
# the relays, so one provider's outage can't take down both the relay and the
# thing that's supposed to notice.

# --- Secrets (required) ---

# Shared bearer token the relay authenticates its push with. Must match the
# relay's RELAY_METRICS_PUSH_TOKEN. Generate one: openssl rand -hex 32
INGEST_TOKEN=

# Gates the operator-only GET endpoints (dry-run analysis and the test email).
# Any random string: openssl rand -hex 16
MANUAL_TRIGGER_SECRET=

# Email delivery via Resend (https://resend.com). ALERT_FROM must be on a domain
# verified in Resend. Resend's free tier (100 emails/day) is far above alert
# volume; this replaces Cloudflare KV as the only external quota, and it is not
# in the per-push path, so it does not run out mid-day the way KV did.
RESEND_API_KEY=
ALERT_FROM=iTerm2 Relay Monitor <alerts@yourdomain.com>
ALERT_TO=you@example.com

# --- Listener (defaults are fine behind a TLS reverse proxy) ---

# Bind loopback only and let Caddy/Apache terminate TLS on the monitor's public
# hostname and reverse-proxy /ingest here (ops/Caddyfile.example). ONE instance
# watches the whole fleet, so relays push per-host:
#   fleet:  each relay POSTs to https://<monitor-host>/ingest/<its-host>
#           e.g. relay1 -> .../ingest/relay1.iterm2.com
#   direct: a single relay POSTs to https://<monitor-host>/ingest
# One proxy route (/ingest -> here) covers all relays; adding a relay needs NO
# monitor-side change (see SHARD_MAP_URL below).
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8790

# Where the latest snapshot + alert state + baselines are persisted. Under
# systemd this is the managed StateDirectory (/var/lib/iterm2-relay-monitor).
MONITOR_STATE_DIR=/var/lib/iterm2-relay-monitor

# How often to analyze (ms). 5 min matches the old cron. Liveness (STALE_MINUTES)
# is what actually detects "relay down"; this is just the check cadence.
MONITOR_INTERVAL_MS=300000

# Fleet dashboard: each host card links to that shard's own detailed dashboard.
# {host} is replaced with the relay's hostname. The managed fleet serves its
# per-box dashboard at https://<host>/dashboard/. Set empty to disable the links.
DASHBOARD_URL_TEMPLATE=https://{host}/dashboard/

# --- Liveness (dead-man's-switch) ---
# Alert if no snapshot has arrived within this many minutes. The relay pushes
# every ~60-240s (RELAY_METRICS_PUSH_MS); keep this comfortably above that.
STALE_MINUTES=9

# --- Outside-in synthetic probe (optional but recommended) ---
# Each tick opens a real WebSocket to the relay's PUBLIC origin and drives a
# mac-park handshake, exercising the whole inbound path (DNS, TLS, firewall,
# proxy, WS upgrade, admission) that the metrics push cannot see.
#
# Pick ONE of the two modes:
#   - Sharded fleet (SHARD_MAP_URL): the shard map is the SINGLE SOURCE OF TRUTH
#     for which hosts exist. Each tick the monitor fetches it and, for every host
#     it names, checks push freshness (liveness) + gauges/counters AND probes the
#     host with a room it OWNS. Adding a relay is therefore zero monitor config:
#     put it in the map and point its push at /ingest/<host>; the monitor
#     discovers it. (Owned-room probing matters: a sharded relay answers HTTP 421
#     reject-on-doubt for any room outside its slice, so a random room false-pages
#     against a host owning a small slice.) A host the map assigns nothing
#     (drained) is skipped; a map that cannot be fetched fails the probe, since if
#     the monitor cannot resolve, clients likely cannot either. RELAY_PROBE_URL
#     is ignored when the map URL is set.
#   - Single direct-mode relay (RELAY_PROBE_URL): one relay, no sharding; it
#     pushes to /ingest and the probe uses a random throwaway room.
# Leave both empty to disable the probe.
SHARD_MAP_URL=https://resolver.iterm2.com/shardmap.json
RELAY_PROBE_URL=
PROBE_TIMEOUT_MS=10000

# --- Capacity: warn/critical when live sockets/rooms cross these fractions of
# the relay's configured caps (match RELAY_MAX_TOTAL_SOCKETS / RELAY_MAX_ROOMS).
SOCKETS_CAP=200000
ROOMS_CAP=200000
CAP_WARN_FRAC=0.7
CAP_CRIT_FRAC=0.9

# --- Error rate over the interval, with an absolute-volume floor.
ERROR_RATIO=0.05
ERROR_MIN_REQUESTS=100

# --- Swallowed process exceptions over the interval: alert at/above this count.
EXCEPTION_THRESHOLD=1

# --- Shard-map fetch errors (distributed mode only; always 0 in direct mode).
SHARD_FETCH_THRESHOLD=1

# --- Traffic anomaly vs the per-hour-of-week baseline. Spike >= SPIKE_FACTOR x,
# drop <= DROP_FACTOR x, once the baseline has >= MIN_SAMPLES weeks and is
# >= MIN_BASELINE req/hour. MAX_SAMPLES is clamped up to MIN_SAMPLES in code so
# the baseline can always warm up.
SPIKE_FACTOR=3
DROP_FACTOR=0.3
MIN_BASELINE=50
MIN_SAMPLES=4
MAX_SAMPLES=8

# --- Do not re-send the same alert within this many minutes (escalation to
# critical bypasses it).
COOLDOWN_MINUTES=360

# --- Debounce for the vantage-sensitive checks (liveness, inbound probe, shard-
# map fetch). These page from the monitor's own network position, so a transient
# blip on the monitor's uplink or the monitor->relay path can false-page even
# while the relay is serving real users fine. Require this many CONSECUTIVE
# failing ticks before paging; one success resets the streak. Clamped to >= 1
# (a blank/0 value keeps the default, not fire-on-first-failure). Set to 1 for
# the old immediate behavior. At the default 5-min tick, 2 means ~10 min of
# sustained failure before a page.
ALERT_FAIL_STREAK=2

# --- Push relay (APNs) card on /fleet (optional; unset PUSH_METRICS_URL to disable) ---
# Scraped each tick; alerts on APNs timeouts, rejected signing key, mostly-failing pushes.
PUSH_METRICS_URL=http://127.0.0.1:8790/metrics
# Public path probe; expects HTTP 405 on GET.
PUSH_PROBE_URL=https://push.iterm2.com/
PUSH_HOST_LABEL=push.iterm2.com
# Link shown on the card (the push-only dashboard).
PUSH_DASHBOARD_URL=
# Peering with a second push relay instance (read from the same /metrics; off
# when the push relay has no PUSH_PEER_URL). Warn after this many ticks in a row
# with registrations still queued for the peer (default 3, ~15 min), and on the
# relays' clock difference (warn / critical, in ms). Also warns when the peer
# drops records as malformed or /peer/register sees a bad secret.
# PUSH_PEER_OUTBOX_STREAK=3
# PUSH_PEER_SKEW_WARN_MS=2000
# PUSH_PEER_SKEW_CRIT_MS=30000
# Warn when the peer hasn't answered an authenticated request for this long
# (the push relay says hello to it every minute when idle).
# PUSH_PEER_SILENT_MS=600000
