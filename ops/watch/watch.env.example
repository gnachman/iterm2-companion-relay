# Copy to watch.env (gitignored) and fill in. All values are optional; the
# defaults work against the current production fleet.

# Name of the screen session the watcher runs in.
WATCH_SESSION=relay-watch

# Heartbeat cadence.
WATCH_QUIET_INTERVAL=120   # seconds between checks while healthy
WATCH_RETRY_INTERVAL=20    # seconds between confirm re-checks after a failure
WATCH_CONFIRM_FAILS=2      # consecutive relay-shaped failures before engaging Claude

# Fleet monitor Basic-auth password (= the monitor's MANUAL_TRIGGER_SECRET), so
# Claude can cross-check the other vantage at https://mcnachman.cloud/fleet.
MONITOR_PASSWORD=

# Phone push credentials are NOT set here. On a Mac, notify.sh reads the iTerm2
# app's stored ones on every page (pushcreds.sh). Elsewhere (the mini PC) they
# live in push.env (gitignored, mode 600): scp the Mac's
# `~/bin/it2-notify --print-secrets` output there; never paste it.

# Shadow mode: log pages (and paging-path emails) to state/ with a SHADOW tag
# instead of sending them, so this watcher can run beside another one without
# double-paging. Remove at cutover and respawn the beat window.
# WATCH_SHADOW=1

# Email fallback (email.sh, via Resend): used when no push relay delivers a page,
# and when the heartbeat finds the paging path broken. Same Resend account as the
# fleet monitor; ALERT_FROM must be on its verified domain.
RESEND_API_KEY=
ALERT_FROM="iTerm2 relay watcher <alerts@iterm2.com>"
ALERT_TO=
# How often the heartbeat checks the paging path, and re-emails while it's broken.
# WATCH_NOTIFY_CHECK_INTERVAL=600
# WATCH_NOTIFY_REMIND_SECONDS=21600

# Push dashboard Basic auth (relay-dashboard login, not the monitor password).
# Claude uses it to cross-check https://mcnachman.cloud/push-dashboard/ on a
# push-unreachable triage.
# PUSH_DASHBOARD_USER=admin
# PUSH_DASHBOARD_PASSWORD=

# Probe tuning (usually leave unset).
# PROBE_TIMEOUT_MS=10000
# SHARD_MAP_URL=https://resolver.iterm2.com/shardmap.json
# RELAY_HOSTS=relay1.iterm2.com,relay2.iterm2.com   # fallback if the map is unreachable
# CONTROL_URLS=https://resolver.iterm2.com/shardmap.json,https://www.cloudflare.com/cdn-cgi/trace,https://www.google.com/generate_204

# Push relays tick.mjs probes (GET /, expects 405), comma-separated, primary
# first. Default: both instances. Empty string = skip the push check.
# PUSH_PROBE_URLS=https://push.iterm2.com/,https://push2.iterm2.com/
